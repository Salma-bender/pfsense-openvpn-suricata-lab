# Règles personnalisées Suricata (interface WAN de pfSense)

# Scan SYN Nmap
alert tcp any any -> $HOME_NET any (msg:"SCAN SYN Nmap detected"; flags:S; threshold:type both, track by_src, count 20, seconds 3; classtype:network-scan; sid:9000001; rev:1;)

# Brute force SSH
alert tcp any any -> $HOME_NET 22 (msg:"BRUTEFORCE SSH attempt"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000002; rev:1;)

# ICMP flood
alert icmp any any -> $HOME_NET any (msg:"ICMP FLOOD detected"; threshold:type both, track by_src, count 50, seconds 10; classtype:denial-of-service; sid:9000003; rev:1;)

# Nmap service detection
alert tcp any any -> $HOME_NET any (msg:"SCAN Service Detection"; content:"Nmap"; nocase; classtype:network-scan; sid:9000004; rev:1;)
